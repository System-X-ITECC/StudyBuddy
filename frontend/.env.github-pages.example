# GitHub Actions substitutes STUDYBUDDY_API_URL into PUBLIC_API_URL.
# The browser sees the API URL, which is not a secret.
PUBLIC_APP_ENV=testbed
PUBLIC_API_URL=https://YOUR-VERCEL-PROJECT.vercel.app
STUDYBUDDY_DEPLOY_TARGET=github-pages
# Do NOT set a service_role/secret key, SMTP key, or DeepSeek API key here.
