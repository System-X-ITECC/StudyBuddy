# Add these to the Vercel PROJECT's Environment Variables UI (do not commit real values).
# Use Vercel project Root Directory = backend.
# "Production" below is Vercel's deployment scope; APP_ENV=testbed is the
# StudyBuddy application environment for this hackathon demo.
APP_ENV=testbed
CLIENT_ORIGINS=https://system-x-itecc.github.io
SUPABASE_URL=https://dhksfuricdmeaeysszyc.supabase.co
EXPECTED_SUPABASE_PROJECT_REF=dhksfuricdmeaeysszyc
SUPABASE_ANON_KEY=YOUR_TESTBED_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_TESTBED_SERVER_SECRET_KEY
ALLOW_REGISTRATION=true
DEEPSEEK_API_KEY=YOUR_SERVER_ONLY_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-chat
# HOST and PORT are not needed on Vercel; the platform invokes the Express handler.
